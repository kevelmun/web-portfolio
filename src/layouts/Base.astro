---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Sigil from '../components/Sigil.astro';
import { identity, nav } from '../data/site';
import { canonical, socialImage, socialImageAlt, structuredData } from '../data/seo';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="night" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="me" href={identity.github} />
    <link rel="me" href={identity.linkedin} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={`Elihan · ${identity.name}`} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0C0B0E" />
    <script is:inline>
      var d = document.documentElement;
      d.classList.remove('no-js');
      try {
        var t = localStorage.getItem('eh-theme');
        if (t === 'night' || t === 'parchment') d.dataset.theme = t;
      } catch (e) {}
      if (d.dataset.theme === 'parchment') {
        document.querySelector('meta[name="color-scheme"]').content = 'light';
        document.querySelector('meta[name="theme-color"]').content = '#F3ECDD';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="#inicio" aria-label="Elihan, inicio">
          <Sigil size={32} />
          <span class="wordmark">Elihan</span>
        </a>
        <nav class="site-nav" aria-label="Secciones">
          {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
        </nav>
        <button class="theme-btn" type="button" id="theme-btn" aria-label="Cambiar entre modo Noche y modo Pergamino">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.5c1.2 1.4 1.8 2.5 1.8 3.5A1.8 1.8 0 0 1 8 6.8 1.8 1.8 0 0 1 6.2 5c0-1 .6-2.1 1.8-3.5Z" /><path d="M5.5 8.5h5v6h-5z" /><path d="M4 14.5h8" /></svg>
          <span id="theme-label">Pergamino</span>
        </button>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <span class="meta">© {new Date().getFullYear()} {identity.name}</span>
        <span class="meta">Hecho con Astro y un poquito de amor.</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-btn');
        var label = document.getElementById('theme-label');
        var schemeMeta = document.querySelector('meta[name="color-scheme"]');
        var chromeMeta = document.querySelector('meta[name="theme-color"]');
        var chrome = { night: '#0C0B0E', parchment: '#F3ECDD' };
        // Tema, esquema de color nativo y color de la barra del navegador cambian juntos.
        function apply(theme) {
          root.dataset.theme = theme;
          schemeMeta.content = theme === 'parchment' ? 'light' : 'dark';
          chromeMeta.content = chrome[theme];
          label.textContent = theme === 'night' ? 'Pergamino' : 'Noche';
        }
        apply(root.dataset.theme === 'parchment' ? 'parchment' : 'night');
        btn.addEventListener('click', function () {
          var next = root.dataset.theme === 'night' ? 'parchment' : 'night';
          apply(next);
          try { localStorage.setItem('eh-theme', next); } catch (e) {}
        });
        // Otra pestaña cambió el tema: seguirla.
        window.addEventListener('storage', function (e) {
          if (e.key === 'eh-theme' && (e.newValue === 'night' || e.newValue === 'parchment')) apply(e.newValue);
        });

        // Scrollspy: nativo con scroll-target-group/:target-current; aria-current se sincroniza al terminar el scroll.
        var links = document.querySelectorAll('.site-nav a');
        function mark(current) {
          links.forEach(function (a) { a.setAttribute('aria-current', a === current ? 'true' : 'false'); });
        }
        var nativeSpy = window.CSS && CSS.supports('scroll-target-group: auto');
        if (nativeSpy) {
          // Chrome actualiza :target-current en el siguiente renderizado: leerlo dos fotogramas después.
          var syncSpy = function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(function () { mark(document.querySelector('.site-nav a:target-current')); });
            });
          };
          syncSpy();
          document.addEventListener('scrollend', syncSpy);
        }

        var items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
          }, { rootMargin: '0px 0px -8% 0px' });
          items.forEach(function (el) { io.observe(el); });

          if (!nativeSpy) {
            var spy = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                var current = null;
                links.forEach(function (a) {
                  var on = a.getAttribute('href') === '#' + e.target.id;
                  a.classList.toggle('target-current', on);
                  if (on) current = a;
                });
                mark(current);
              });
            }, { rootMargin: '-40% 0px -55% 0px' });
            document.querySelectorAll('main section[id]').forEach(function (s) { spy.observe(s); });
          }
        }
      })();
    </script>
  </body>
</html>
