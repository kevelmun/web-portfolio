---
// Retrato en mosaico dentro de un marco redondo, guiño al rosetón de 12 radios (Canvas2D).
// Reinterpreta el efecto «Electric Gaze» con el Elihan Design System:
// celdas de piedra, marfil y oro en Noche; tinta sobre pergamino de día.
// El movimiento es una luz de vela lenta, no un parpadeo.
interface Props { src: string; alt: string }
const { src, alt } = Astro.props;

// Parámetros del motor: tócalos aquí.
const params = {
  zoom: 1.07,        // alto de la foto respecto al marco
  offsetY: 0.05,     // desplazamiento vertical de la foto (fracción del marco)
  cellSize: 4,        // px CSS por celda
  density: 0.86,      // tamaño máximo de la celda respecto a la rejilla (0–1)
  minCell: 0.2,       // tamaño mínimo dentro de la silueta, para que traje y pelo no desaparezcan
  brightness: 0.02,   // −1 a 1
  contrast: 1.55,     // 1 = sin cambio
  gamma: 0.95,        // curva de tono (<1 aclara los medios)
  edgeEmphasis: 0.5,  // oscurece los bordes (gafas, ojos, boca) para que se lean
  vignette: 0.6,      // 0–1
  animIntensity: 0.22, // amplitud de la vela (0 = quieto)
  animSpeed: 0.55,    // 1 ≈ un ciclo cada 4 s
  pointerLight: 0.35, // cuánto ilumina el cursor al pasar
  fps: 24,
};
---
<figure class="arch-portrait" data-params={JSON.stringify(params)} data-src={src}>
  <canvas role="img" aria-label={alt}></canvas>
  <noscript><img src={src} alt={alt} /></noscript>
  <svg viewBox="0 0 320 320" fill="none" aria-hidden="true">
    <circle cx="160" cy="160" r="156" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 4" opacity="var(--construction)" />
    <g stroke="currentColor" stroke-width="1" opacity="0.8"><line x1="160" y1="6" x2="160" y2="12" transform="rotate(30 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(60 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(90 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(120 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(150 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(180 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(210 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(240 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(270 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(300 160 160)" /><line x1="160" y1="6" x2="160" y2="12" transform="rotate(330 160 160)" /></g>
    <circle cx="160" cy="160" r="148" stroke="currentColor" stroke-width="1.5" />
    <path d="M160 2 L164 9 L160 16 L156 9 Z" fill="var(--sigil-spark)" />
  </svg>
  <figcaption class="caps">Depth · Curiosity · Soul</figcaption>
</figure>

<style>
  .arch-portrait { position: relative; margin: 0; color: var(--arch-frame); }
  .arch-portrait svg { position: relative; width: 100%; height: auto; overflow: visible; pointer-events: none; }
  .arch-portrait canvas { position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 1; }
  .arch-portrait noscript img { position: absolute; left: 4%; top: 4%; width: 92%; height: 92%; object-fit: cover; object-position: 50% 12%; border-radius: 50%; }
  .arch-portrait figcaption { margin-top: var(--space-4); text-align: center; color: var(--gold); }
</style>

<script>
  type P = { zoom: number; offsetY: number; cellSize: number; density: number; minCell: number; brightness: number; contrast: number; gamma: number; edgeEmphasis: number; vignette: number; animIntensity: number; animSpeed: number; pointerLight: number; fps: number };

  function hexToRgb(v: string): [number, number, number] {
    const h = v.trim().replace('#', '');
    const n = parseInt(h.length === 3 ? h.split('').map((c) => c + c).join('') : h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  const mix = (a: number[], b: number[], t: number) => `rgb(${Math.round(a[0] + (b[0] - a[0]) * t)},${Math.round(a[1] + (b[1] - a[1]) * t)},${Math.round(a[2] + (b[2] - a[2]) * t)})`;

  function mount(fig: HTMLElement) {
    const canvas = fig.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const p: P = JSON.parse(fig.dataset.params!);
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const img = new Image();
    let cols = 0, rows = 0, W = 0, H = 0, dpr = 1;
    let tone = new Float32Array(0), vig = new Float32Array(0), alpha = new Float32Array(0), phase = new Float32Array(0);
    let ramp: string[] = [];
    let night = true;
    let pointer: { x: number; y: number } | null = null;
    let visible = true, raf = 0, last = 0;

    // Paleta desde los tokens: se vuelve a leer al cambiar de tema.
    function palette() {
      const cs = getComputedStyle(root);
      const tok = (n: string) => hexToRgb(cs.getPropertyValue(n));
      night = root.dataset.theme !== 'parchment';
      const stops = night
        ? [tok('--ash'), tok('--stone-500'), tok('--gold-300'), tok('--ivory')]
        : [tok('--stone-400'), tok('--stone-700'), tok('--wine-900'), tok('--obsidian')];
      ramp = Array.from({ length: 32 }, (_, i) => {
        const t = (i / 31) * (stops.length - 1);
        const k = Math.min(stops.length - 2, Math.floor(t));
        return mix(stops[k], stops[k + 1], t - k);
      });
    }

    // Recorte circular, justo por dentro del aro del SVG (320 × 320).
    function framePath() {
      const s = W / 320;
      ctx.beginPath();
      ctx.arc(160 * s, 160 * s, 144 * s, 0, Math.PI * 2);
      ctx.closePath();
    }

    function sample() {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !img.naturalWidth) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      cols = Math.floor(W / p.cellSize); rows = Math.floor(H / p.cellSize);

      // Paso 1–2: dibujar la foto a resolución de rejilla y leer luminancia y alfa por celda.
      const off = document.createElement('canvas');
      off.width = cols; off.height = rows;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      // Encuadre de busto: cabeza y hombros dentro del círculo.
      const ih = rows * p.zoom, iw = ih * (img.naturalWidth / img.naturalHeight) * (cols / rows) * (H / W);
      o.imageSmoothingQuality = 'high';
      o.drawImage(img, (cols - iw) / 2, rows * p.offsetY, iw, ih);
      const d = o.getImageData(0, 0, cols, rows).data;
      const n = cols * rows;
      tone = new Float32Array(n); vig = new Float32Array(n); alpha = new Float32Array(n);
      if (phase.length !== n) { phase = new Float32Array(n); for (let i = 0; i < n; i++) phase[i] = Math.random() * Math.PI * 2; }
      const raw = new Float32Array(n);
      for (let i = 0; i < n; i++) raw[i] = (0.2126 * d[i * 4] + 0.7152 * d[i * 4 + 1] + 0.0722 * d[i * 4 + 2]) / 255;
      for (let i = 0; i < n; i++) {
        let l = raw[i];
        // Realce de bordes: resta el gradiente local de luminancia.
        const cx = i % cols, cy = Math.floor(i / cols);
        if (p.edgeEmphasis && cx > 0 && cx < cols - 1 && cy > 0 && cy < rows - 1) {
          const gx = raw[i + 1] - raw[i - 1], gy = raw[i + cols] - raw[i - cols];
          l -= p.edgeEmphasis * Math.min(0.35, Math.hypot(gx, gy)) * 0.6;
        }
        l = (l - 0.5) * p.contrast + 0.5 + p.brightness;
        l = Math.pow(Math.min(1, Math.max(0, l)), p.gamma);
        // Viñeta: la luz se concentra en la cara.
        const x = (i % cols) / cols - 0.5, y = Math.floor(i / cols) / rows - 0.46;
        vig[i] = Math.max(0, 1 - p.vignette * Math.min(1, (x * x + y * y) * 3.4));
        tone[i] = l;
        alpha[i] = d[i * 4 + 3] / 255;
      }
    }

    function draw(t: number) {
      if (!cols) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      framePath(); ctx.clip();
      const cw = W / cols, ch = H / rows;
      const still = reduce.matches || p.animIntensity === 0;
      const time = (t / 1000) * p.animSpeed * (Math.PI / 2);
      const breath = still ? 0 : Math.sin(time * 0.6) * 0.35; // la llama entera sube y baja
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const k = j * cols + i;
          const a = alpha[k];
          if (a < 0.04) continue;
          let l = tone[k];
          if (!still) l *= 1 + p.animIntensity * (Math.sin(time + phase[k]) * 0.65 + breath);
          if (pointer) {
            const dx = (i + 0.5) * cw - pointer.x, dy = (j + 0.5) * ch - pointer.y;
            l += p.pointerLight * Math.exp(-(dx * dx + dy * dy) / 2600);
          }
          l = Math.min(1, Math.max(0, l));
          // De noche pesa la luz; de día, la tinta.
          // La viñeta apaga la luz de noche y destiñe la tinta de día.
          const w = (night ? l : 1 - l) * vig[k];
          const size = a * (p.minCell * (0.4 + 0.6 * vig[k]) + (1 - p.minCell) * w) * p.density;
          if (size < 0.06) continue;
          ctx.fillStyle = ramp[Math.round(w * 31)];
          const sw = cw * size, sh = ch * size;
          ctx.fillRect((i + 0.5) * cw - sw / 2, (j + 0.5) * ch - sh / 2, sw, sh);
        }
      }
      ctx.restore();
    }

    function loop(t: number) {
      raf = 0;
      if (!visible) return;
      if (t - last >= 1000 / p.fps) { last = t; draw(t); }
      if (!reduce.matches && p.animIntensity > 0) raf = requestAnimationFrame(loop);
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame((t) => { last = 0; loop(t); }); };

    img.onload = () => { palette(); sample(); kick(); };
    img.src = fig.dataset.src!;

    new ResizeObserver(() => { sample(); kick(); }).observe(canvas);
    new MutationObserver(() => { palette(); kick(); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; if (visible) kick(); }).observe(canvas);
    reduce.addEventListener('change', kick);
    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
      kick();
    });
    canvas.addEventListener('pointerleave', () => { pointer = null; kick(); });
  }

  document.querySelectorAll<HTMLElement>('.arch-portrait').forEach(mount);
</script>
