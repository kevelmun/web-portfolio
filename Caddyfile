# Alternativa local; Dokploy sirve Nginx con Dockerfile.dokploy.
:80 {
	@www host www.kevelmun.dev
	redir @www https://kevelmun.dev{uri} 301
	root * /usr/share/caddy
	encode zstd gzip
	header {
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
	header /sitemap.xml Content-Type "application/xml; charset=utf-8"
	@index path /index.html /index.htm
	redir @index /?{query} 301
	@retired path /workspace /workspace/
	error @retired 410
	@errorPages path /404.html /410.html
	error @errorPages 404
	@hashed file
	handle /_astro/* {
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	file_server
	handle_errors {
		rewrite * /{err.status_code}.html
		header Cache-Control "no-cache"
		file_server
	}
}
